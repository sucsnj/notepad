# Porta do servidor backend (Fastify).
PORT=3001

# Host de bind (0.0.0.0 libera acesso por LAN/Tailscale/Radmin).
HOST=0.0.0.0

# Caminho do banco SQLite (node:sqlite). Relativo a raiz do backend.
DATABASE_PATH=./data/notepad.db

# Diretorio de uploads (anexos novos). Relativo a raiz do backend.
UPLOAD_DIR=./data/uploads

# Tamanho maximo de cada upload, em megabytes.
MAX_UPLOAD_SIZE_MB=20

# Origens permitidas no CORS (separadas por virgula). Em branco = qualquer origem.
# Necessario apenas se o frontend chamar o backend diretamente (sem proxy).
CORS_ORIGIN=
