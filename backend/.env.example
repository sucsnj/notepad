# Porta do servidor backend (Fastify).
PORT=3010

# Host de bind (0.0.0.0 libera acesso por LAN/Tailscale/Radmin).
HOST=0.0.0.0

# Caminho do banco SQLite (node:sqlite). Relativo a raiz do backend.
DATABASE_PATH=./data/notepad.db

# Diretorio de uploads (anexos novos). Relativo a raiz do backend.
UPLOAD_DIR=./data/uploads

# Tamanho maximo de cada upload, em megabytes.
MAX_UPLOAD_SIZE_MB=20

# Origens permitidas no CORS (separadas por virgula). Em branco = qualquer origem.
# Necessario apenas se o frontend chamar o backend diretamente (sem proxy).
CORS_ORIGIN=

# Token de acesso a API (Authorization: Bearer). Obrigatorio.
# Sem este valor a API recusa todas as requisicoes (503) - falha fechada.
# Defina um valor longo e aleatorio antes de rodar.
# O frontend precisa do mesmo valor em BACKEND_TOKEN.
API_TOKEN=

# --- Docker / tunel (usados pelo compose, opcional) ---

# Endereco de publicacao da porta no host. 127.0.0.1 = somente local (padrao,
# recomendado). Use 0.0.0.0 para expor na LAN/Tailscale.
BIND_ADDRESS=127.0.0.1

# Token do tunel Cloudflare (Zero Trust > Networks > Tunnels > Create).
# Necessario apenas para `docker compose --profile tunnel up -d`.
TUNNEL_TOKEN=
