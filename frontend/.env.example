# Porta do servidor frontend (Next.js), lida por scripts/serve.mjs.
PORT=3011

# URL do backend standalone (Fastify). O frontend faz proxy de /api e /uploads
# para este endereco. Em producao, aponte para o host/porta do backend.
BACKEND_URL=http://127.0.0.1:3010

# Token que o frontend envia ao backend (Authorization: Bearer). Obrigatorio.
# Deve ser igual ao API_TOKEN do backend. Fica somente no servidor: nunca chega
# ao navegador. Sem ele, o proxy recusa as chamadas com 503.
BACKEND_TOKEN=

# Senha de acesso a aplicacao (tela /entrar). Obrigatorio.
# Sem este valor ninguem consegue entrar e o login responde 503.
APP_PASSWORD=

# Origens adicionais permitidas no modo dev (separadas por virgula).
# Em branco = usa os padroes: *.*.*.* (IPs numericos), **.local (nomes .local).
# Wildcards: * casa 1 rotulo, ** casa 1 ou mais. Ex.: meu-pc.tail12345.ts.net
ALLOWED_DEV_ORIGINS=
