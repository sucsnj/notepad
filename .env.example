# Porta do servidor HTTP usada por `npm run dev` / `npm run start`.
# O Next.js nao le PORT a partir do .env, por isso os scripts em scripts/serve.mjs
# carregam este valor e repassam via flag `-p`.
PORT=3000

# Caminho do banco SQLite, relativo a raiz do projeto.
DATABASE_PATH=./data/notepad.db

# Diretorio fisico onde os arquivos enviados sao gravados.
# Ele e servido publicamente pela URL /uploads.
UPLOAD_DIR=./public/uploads

# Tamanho maximo de cada upload, em megabytes.
MAX_UPLOAD_SIZE_MB=20
