# Porta de acesso do servidor (lida pelo scripts/serve.mjs).
PORT=3000

# Caminho do banco SQLite (node:sqlite). Relativo a raiz do projeto.
DATABASE_PATH=./data/notepad.db

# Diretorio de uploads (anexos novos). Fora de public/: arquivos sao servidos em
# runtime por app/api/attachments/[noteId]/[storedName]/route.ts, validados no SQLite.
# Relativo a raiz do projeto.
UPLOAD_DIR=./data/uploads

# Tamanho maximo de cada upload, em megabytes.
MAX_UPLOAD_SIZE_MB=20

# Origens adicionais permitidas no modo dev (separadas por virgula).
# Em branco = usa os padroes: *.*.*.* (IPs numericos), **.local (nomes .local).
# Wildcards: * casa 1 rotulo, ** casa 1 ou mais. Ex.: meu-pc.tail12345.ts.net
ALLOWED_DEV_ORIGINS=